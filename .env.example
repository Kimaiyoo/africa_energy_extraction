MONGO_URI=mongodb://localhost:27017/
MONGO_DB=energy_data
MONGO_COLLECTION=observations

# From your browser: DevTools -> Network -> get-database-data -> Request Headers.
# Both values must come from the same browser session.
AEP_COOKIE=
AEP_USER_AGENT=

# Optional: file with one portal country name per line
COUNTRIES_FILE=

# Dashboard -> API
API_URL=http://localhost:8000
